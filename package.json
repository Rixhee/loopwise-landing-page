{
  "name": "loopwise-landing-page",
  "private": true,
  "version": "1.0.0",
  "description": "Loopwise early-access landing page (Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init:local": "wrangler d1 execute loopwise --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute loopwise --remote --file=schema.sql",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

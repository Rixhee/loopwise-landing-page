{
  "name": "loopwise-landing-page",
  "private": true,
  "version": "1.0.0",
  "description": "Loopwise early-access landing page (Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply loopwise --local",
    "db:migrate:remote": "wrangler d1 migrations apply loopwise --remote",
    "deploy": "wrangler pages deploy --project-name getloopwise --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
